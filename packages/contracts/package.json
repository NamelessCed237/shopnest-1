    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@shopnest/config": "workspace:*",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
