# Valeurs de DÉVELOPPEMENT, versionnées volontairement.
#
# Sans ce fichier, la boutique appelle l'API sans identifier de tenant et
# reçoit « tenant context missing » sur chaque requête : catalogue vide et
# paiement impossible, sans explication à l'écran.
#
# Ne contient aucun secret : tout ce qui est préfixé VITE_ finit dans le bundle.

VITE_API_URL=/api

# Boutique de développement. En production le tenant vient du sous-domaine
# (`alpha-electronics.shopnest.app`) ou du domaine personnalisé ; `localhost`
# n'en a pas, d'où cette variable — même mécanisme que le dashboard.
#
# Correspond au seed (`pnpm --filter @shopnest/api db:seed`). L'autre boutique
# est `beta-mode`.
VITE_DEV_TENANT=alpha-electronics
