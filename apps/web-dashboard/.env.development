# Valeurs de DÉVELOPPEMENT, versionnées volontairement.
#
# Sans ce fichier, un clone frais démarre sans configuration : le dashboard
# tente d'appeler une API qui n'existe pas encore et l'écran de connexion
# échoue sans explication. `.env.local` est ignoré par git et ne peut donc pas
# jouer ce rôle.
#
# Ne contient aucun secret : tout ce qui est préfixé VITE_ finit dans le bundle.

VITE_API_URL=/api

# Domaines déjà servis par l'API réelle (doc/09 §11).
# Vide = tout en données factices. Ajoutez les domaines au fur et à mesure que
# les modules backend sont livrés.
VITE_LIVE_DOMAINS=auth,products

# Tenant de développement : localhost n'a pas de sous-domaine d'où le déduire.
# Correspond au seed (`pnpm --filter @shopnest/api db:seed`). L'autre boutique
# est `beta-mode` — la basculer ici est le moyen le plus simple de vérifier de
# visu que l'isolation tient.
VITE_DEV_TENANT=alpha-electronics
