{
  "name": "@shopnest/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind/preset": {
      "types": "./tailwind/preset.d.ts",
      "default": "./tailwind/preset.js"
