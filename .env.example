# Copier en .env — valeurs FACTICES, jamais de vrai secret ici (doc/02 §11).
# Toute variable est validée au démarrage par apps/api/src/config/env.schema.ts :
# l'API refuse de démarrer si l'une manque.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://shopnest:shopnest@localhost:5432/shopnest
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key-change-me

# 32 caractères minimum, distincts par audience (doc/03 §5)
JWT_CUSTOMER_SECRET=dev-customer-secret-change-me-000
JWT_TENANT_SECRET=dev-tenant-secret-change-me-00000
JWT_ADMIN_SECRET=dev-admin-secret-change-me-000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0000

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_API_KEY=

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=shopnest-dev
STORAGE_ACCESS_KEY=shopnest
STORAGE_SECRET_KEY=shopnest-dev

APP_BASE_DOMAIN=shopnest.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Clients web
VITE_API_URL=/api
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Mode démonstration : API factice côté dashboard, aucune base requise.
# À retirer dès que PostgreSQL est accessible (un build PROD avec ce drapeau échoue).
VITE_FAKE_API=true
