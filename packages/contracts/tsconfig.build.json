{
  // Émission JavaScript pour les consommateurs qui NE PASSENT PAS par un
  // bundler — l'API NestJS, compilée par tsc puis exécutée par Node brut.
  //
  // Les apps web importent la source TypeScript (condition `development` du
  // champ `exports`) : Vite la compile lui-même, et un dist intermédiaire
  // casserait le rechargement à chaud.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
