# Copier en .env — valeurs FACTICES, jamais de vrai secret ici (doc/02 §11).
# Toute variable est validée au démarrage par apps/api/src/config/env.schema.ts :
# l'API refuse de démarrer si l'une manque.

NODE_ENV=development
PORT=3000

# ============================================================================
# SUPABASE — voir doc/09-supabase.md pour la procédure complète
# ============================================================================
#
# DEUX URL, et ce n'est pas une redondance :
#
# · DATABASE_URL passe par le POOLER (port 6543). C'est la connexion de
#   l'application. `pgbouncer=true` est obligatoire : le pooler en mode
#   transaction ne supporte pas les requêtes préparées nommées de Prisma.
#   `connection_limit=1` évite d'épuiser le pool sur le plan gratuit.
#
# · DIRECT_URL passe en DIRECT (port 5432). Elle ne sert qu'aux migrations,
#   qui posent un verrou consultatif que le pooler ne relaie pas. Sans elle,
#   `prisma migrate` se bloque sans message d'erreur.
#
# L'utilisateur de DATABASE_URL doit être `shopnest_app` et non `postgres` :
# `postgres` contourne la RLS sur Supabase, ce qui désactiverait la deuxième
# barrière d'isolation multi-tenant (apps/api/prisma/supabase/01-app-role.sql).
DATABASE_URL=postgresql://shopnest_app:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.VOTRE_REF_PROJET:MOT_DE_PASSE_POSTGRES@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# 32 caractères minimum, distincts par audience (doc/03 §5)
# Générer avec : openssl rand -base64 32
JWT_CUSTOMER_SECRET=dev-customer-secret-change-me-000
JWT_TENANT_SECRET=dev-tenant-secret-change-me-00000
JWT_ADMIN_SECRET=dev-admin-secret-change-me-000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0000

APP_BASE_DOMAIN=shopnest.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ============================================================================
# OPTIONNEL EN LOCAL — obligatoire en staging et en production
# ============================================================================
#
# L'API démarre sans ces variables en développement : Redis, la recherche, le
# paiement et le stockage ne sont pas nécessaires pour lire et écrire des
# produits. En production, leur absence bloque le démarrage.

# REDIS_URL=redis://localhost:6379
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=dev-master-key-change-me

# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_API_KEY=
# MTN_MOMO_WEBHOOK_SECRET=
# ORANGE_MONEY_BASE_URL=
# ORANGE_MONEY_API_KEY=

# Stockage des images produit. Supabase Storage est compatible S3 :
# Project Settings > Storage > S3 Connection.
# STORAGE_ENDPOINT=https://VOTRE_REF_PROJET.supabase.co/storage/v1/s3
# STORAGE_BUCKET=shopnest-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ============================================================================
# Clients web
# ============================================================================
VITE_API_URL=/api
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api
